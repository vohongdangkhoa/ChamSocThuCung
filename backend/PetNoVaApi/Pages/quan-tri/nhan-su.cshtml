@page
@{
    ViewData["Title"] = "Nhân sự";
}
<section data-page="nhan-su">
  <div class="dau-trang"><h1>Nhân sự</h1></div>
  <div class="khung khoang">
    <h2>Tạo tài khoản nhân sự</h2>
    <form id="form-nhan-su" class="form">
      <div class="cot-2">
        <label>Họ tên<input name="fullName" required /></label
        ><label>Email<input name="email" type="email" required /></label
        ><label>Điện thoại<input name="phone" required /></label
        ><label
          >Mật khẩu ban đầu<input
            name="password"
            type="password"
            minlength="6"
            required
        /></label>
      </div>
      <label
        >Vai trò<select name="role">
          <option value="STAFF">Nhân viên</option>
          <option value="VET">Bác sĩ</option>
        </select></label
      ><button class="nut">Tạo nhân sự</button>
    </form>
  </div>
  <div id="danh-sach-nhan-su" class="danh-sach"></div>
</section>
