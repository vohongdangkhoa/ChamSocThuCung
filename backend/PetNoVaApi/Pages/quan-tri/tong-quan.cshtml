@page
@{
    ViewData["Title"] = "Báo cáo";
}
<section data-page="tong-quan">
  <div class="dau-trang">
    <h1>Báo cáo quản trị</h1>
    <p>Tình hình lịch hẹn, doanh thu và hoạt động hệ thống.</p>
  </div>
  <form id="form-bao-cao" class="hang khoang">
    <label>Từ ngày<input name="from" type="date" /></label
    ><label>Đến ngày<input name="to" type="date" /></label
    ><button class="nut">Xem báo cáo</button>
  </form>
  <div id="so-lieu" class="luoi"></div>
  <pre id="bao-cao-chi-tiet" class="khung bang-cuon"></pre>
</section>
