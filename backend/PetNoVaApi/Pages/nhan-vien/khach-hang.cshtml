@page
@{
    ViewData["Title"] = "Khách hàng";
}
<section data-page="khach-hang">
  <div class="dau-trang">
    <h1>Khách hàng</h1>
    <p>Thông tin liên hệ và thú cưng để hỗ trợ lịch hẹn.</p>
  </div>
  <label class="khoang"
    >Tìm tên, số điện thoại<input
      id="tim-khach"
      type="search"
      placeholder="Nhập để lọc"
  /></label>
  <div id="danh-sach-khach" class="danh-sach"></div>
</section>
