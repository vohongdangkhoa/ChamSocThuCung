@page
@{
    ViewData["Title"] = "Lịch hẹn";
}
<section data-page="lich-hen">
  <div class="dau-trang">
    <h1>Lịch hẹn</h1>
    <p>Xác nhận, phân công và cập nhật tiến độ.</p>
  </div>
  <label class="khoang"
    >Lọc trạng thái<select id="loc-lich">
      <option value="">Tất cả</option>
      <option value="PENDING">Chờ xác nhận</option>
      <option value="CONFIRMED">Đã xác nhận</option>
      <option value="IN_PROGRESS">Đang chăm sóc</option>
      <option value="COMPLETED">Hoàn thành</option>
      <option value="CANCELLED">Đã hủy</option>
    </select></label
  >
  <div id="danh-sach-lich" class="danh-sach"></div>
</section>
