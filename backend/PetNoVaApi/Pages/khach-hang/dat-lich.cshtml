@page
@{
    ViewData["Title"] = "Đặt lịch";
}
<section data-page="dat-lich">
  <div class="dau-trang">
    <h1>Đặt lịch chăm sóc</h1>
    <p>Chọn bé, dịch vụ và khung giờ còn trống.</p>
  </div>
  <div class="khung">
    <form id="form-dat-lich" class="form">
      <div class="cot-2">
        <label>Thú cưng<select name="petId" required></select></label
        ><label
          >Loại chăm sóc<select name="careTypeId" required></select
        ></label>
      </div>
      <div>
        <strong>Dịch vụ</strong>
        <div id="chon-dich-vu" class="chon-dich-vu them-khoang"></div>
      </div>
      <div class="cot-2">
        <label
          >Ngày hẹn<input
            name="bookingDate"
            type="date"
            required /></label
        ><label
          >Nhân sự (không bắt buộc)<select name="staffId">
            <option value="">Để PetNoVa phân công</option>
          </select></label
        >
      </div>
      <button id="kiem-tra-gio" type="button" class="nut nut-phu">
        Xem giờ còn trống</button
      ><label
        >Giờ hẹn<select name="bookingTime" required>
          <option value="">Chọn ngày/dịch vụ rồi xem giờ</option>
        </select></label
      ><label
        >Ghi chú<textarea
          name="note"
          maxlength="1000"
        ></textarea></label
      ><label
        >Thanh toán<select name="paymentMethod">
          <option value="CASH">Tiền mặt tại cửa hàng</option>
          <option value="BANK_TRANSFER">Chuyển khoản PayOS</option>
        </select></label
      >
      <p id="tong-tien" class="nho"></p>
      <button class="nut">Xác nhận đặt lịch</button>
    </form>
  </div>
</section>
