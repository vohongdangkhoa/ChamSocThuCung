@page
@{
    ViewData["Title"] = "Thú cưng";
}
<section data-page="thu-cung">
  <div class="dau-trang">
    <h1>Thú cưng của tôi</h1>
    <p>Hồ sơ được dùng khi đặt lịch và theo dõi sức khỏe.</p>
  </div>
  <div class="cot-2">
    <div class="khung">
      <h2>Thêm hoặc sửa thú cưng</h2>
      <form id="form-thu-cung" class="form">
        <input type="hidden" name="petId" /><label
          >Tên bé<input name="petName" maxlength="100" required
        /></label>
        <div class="cot-2">
          <label
            >Loài<input
              name="species"
              placeholder="Chó, mèo..."
              maxlength="50"
              required /></label
          ><label
            >Giống<input name="breed" maxlength="100" required
          /></label>
        </div>
        <div class="cot-2">
          <label
            >Giới tính<select name="gender">
              <option>Đực</option>
              <option>Cái</option>
              <option>Khác</option>
            </select></label
          ><label
            >Ngày sinh<input name="birthDate" type="date" required
          /></label>
        </div>
        <div class="cot-2">
          <label
            >Cân nặng (kg)<input
              name="weight"
              type="number"
              min="0.1"
              max="999"
              step="0.1"
              required /></label
          ><label
            >Tình trạng sức khỏe<input
              name="healthStatus"
              maxlength="255"
              placeholder="Bình thường"
          /></label>
        </div>
        <button class="nut">Lưu hồ sơ</button
        ><button
          id="huy-sua-thu"
          type="button"
          class="nut nut-phu"
          hidden
        >
          Hủy sửa
        </button>
      </form>
    </div>
    <div>
      <h2>Danh sách thú cưng</h2>
      <div id="danh-sach-thu" class="danh-sach"></div>
    </div>
  </div>
</section>
